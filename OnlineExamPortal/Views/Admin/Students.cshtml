@model List<OnlineExamPortal.Models.User>
@{
    ViewData["Title"] = "Students";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color:var(--dark)">
            <i class="fas fa-users me-2" style="color:var(--primary)"></i>Registered Students
        </h3>
        <span class="badge bg-primary fs-6">@Model.Count Students</span>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>#</th><th>Name</th><th>Email</th><th>Registered On</th></tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-muted">@s.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                     style="width:36px;height:36px;background:var(--primary);font-size:.9rem">
                                    @s.Name[0].ToString().ToUpper()
                                </div>
                                <span class="fw-semibold">@s.Name</span>
                            </div>
                        </td>
                        <td class="text-muted">@s.Email</td>
                        <td class="text-muted small">@s.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center py-4 text-muted">No students registered yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
