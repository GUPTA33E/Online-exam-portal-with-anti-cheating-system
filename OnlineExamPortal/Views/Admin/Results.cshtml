@model List<OnlineExamPortal.Models.Result>
@{
    ViewData["Title"] = "All Results";
    var exams = (List<OnlineExamPortal.Models.Exam>)ViewBag.Exams;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color:var(--dark)">
            <i class="fas fa-chart-bar me-2" style="color:var(--primary)"></i>Student Results
        </h3>
        <!-- Filter -->
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="examId" class="form-select form-select-sm" style="width:220px"
                    onchange="this.form.submit()">
                <option value="">All Exams</option>
                @foreach (var e in exams)
                {
                    <option value="@e.Id" selected="@(ViewBag.SelectedExamId?.ToString() == e.Id.ToString())">
                        @e.Title
                    </option>
                }
            </select>
        </form>
    </div>

    <!-- Summary cards -->
    @if (Model.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-3">
                <div class="card text-center p-3">
                    <div class="fw-bold fs-4 text-primary">@Model.Count</div>
                    <div class="text-muted small">Total Attempts</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="card text-center p-3">
                    <div class="fw-bold fs-4 text-success">@Model.Count(r => r.IsPassed)</div>
                    <div class="text-muted small">Passed</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="card text-center p-3">
                    <div class="fw-bold fs-4 text-danger">@Model.Count(r => !r.IsPassed)</div>
                    <div class="text-muted small">Failed</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="card text-center p-3">
                    <div class="fw-bold fs-4 text-warning">@Math.Round(Model.Average(r => r.Percentage), 1)%</div>
                    <div class="text-muted small">Average Score</div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student</th>
                        <th>Exam</th>
                        <th>Score</th>
                        <th>Percentage</th>
                        <th>Grade</th>
                        <th>Warnings</th>
                        <th>Auto-Sub</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    string grade = r.Percentage >= 90 ? "A+" : r.Percentage >= 80 ? "A" :
                                   r.Percentage >= 70 ? "B"  : r.Percentage >= 60 ? "C" :
                                   r.Percentage >= 40 ? "D"  : "F";
                    <tr>
                        <td class="text-muted">@r.Id</td>
                        <td class="fw-semibold">@r.User?.Name</td>
                        <td class="text-muted small">@r.Exam?.Title</td>
                        <td>@r.Score / @r.TotalMarks</td>
                        <td>
                            <div class="progress" style="height:8px;width:80px">
                                <div class="progress-bar @(r.IsPassed ? "bg-success" : "bg-danger")"
                                     style="width:@r.Percentage%"></div>
                            </div>
                            <small>@r.Percentage%</small>
                        </td>
                        <td><span class="badge bg-primary">@grade</span></td>
                        <td>
                            @if (r.CheatWarnings > 0)
                            { <span class="badge bg-warning text-dark">@r.CheatWarnings ⚠</span> }
                            else
                            { <span class="text-muted small">0</span> }
                        </td>
                        <td>
                            @if (r.AutoSubmitted)
                            { <span class="badge bg-danger">Yes</span> }
                            else
                            { <span class="text-muted small">No</span> }
                        </td>
                        <td>
                            @if (r.IsPassed)
                            { <span class="badge bg-success">Pass</span> }
                            else
                            { <span class="badge bg-danger">Fail</span> }
                        </td>
                        <td class="text-muted small">@r.SubmittedAt.ToString("dd MMM yy HH:mm")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">No results found.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
