@model OnlineExamPortal.Models.ViewModels.ExamCreateViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Exam" : "Edit Exam";
}

<div class="container" style="max-width:640px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Exams" class="btn btn-outline-secondary btn-sm me-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h3 class="fw-bold mb-0" style="color:var(--dark)">
            <i class="fas fa-@(Model.Id == 0 ? "plus" : "edit") me-2" style="color:var(--primary)"></i>
            @ViewData["Title"]
        </h3>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="@(Model.Id == 0 ? "CreateExam" : "EditExam")" method="post">
                <input asp-for="Id" type="hidden"/>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Exam Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. C# Programming Basics"/>
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Brief description of the exam..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="DurationMinutes" class="form-label fw-semibold">
                        Duration (Minutes) *
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-clock text-muted"></i></span>
                        <input asp-for="DurationMinutes" class="form-control" type="number" min="5" max="180"/>
                        <span class="input-group-text">min</span>
                    </div>
                    <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch"/>
                        <label class="form-check-label fw-semibold" for="isActiveSwitch">
                            Active (visible to students)
                        </label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>@(Model.Id == 0 ? "Create Exam" : "Save Changes")
                    </button>
                    <a asp-action="Exams" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
