@model List<OnlineExamPortal.Models.Exam>
@{
    ViewData["Title"] = "Student Dashboard";
    var attempted = (List<int>)ViewBag.AttemptedExamIds;
}

<div class="container-fluid">
    <div class="mb-4">
        <h3 class="fw-bold" style="color:var(--dark)">
            <i class="fas fa-home me-2" style="color:var(--primary)"></i>
            Welcome, @User.Identity!.Name!
        </h3>
        <p class="text-muted">Select an exam below to begin. Read all rules carefully before starting.</p>
    </div>

    <!-- Info strip -->
    <div class="alert alert-info d-flex align-items-center gap-3 mb-4" role="alert">
        <i class="fas fa-shield-alt fa-2x"></i>
        <div>
            <strong>Anti-Cheat Active:</strong> Tab switching, right-click, copy-paste, and leaving full-screen
            are monitored. Violations will be logged and may auto-submit your exam.
        </div>
    </div>

    <!-- Exam cards -->
    <div class="row g-4">
        @foreach (var exam in Model)
        {
            bool done = attempted.Contains(exam.Id);
            <div class="col-sm-6 col-xl-4">
                <div class="card h-100 @(done ? "border-success" : "")">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="rounded-3 p-3 d-inline-block"
                                 style="background:var(--light-bg)">
                                <i class="fas fa-file-alt fa-lg" style="color:var(--primary)"></i>
                            </div>
                            @if (done)
                            { <span class="badge bg-success"><i class="fas fa-check me-1"></i>Completed</span> }
                            else
                            { <span class="badge bg-primary">Available</span> }
                        </div>

                        <h5 class="fw-bold mb-1">@exam.Title</h5>
                        <p class="text-muted small mb-3">@(string.IsNullOrEmpty(exam.Description) ? "No description." : exam.Description)</p>

                        <div class="d-flex gap-3 text-muted small mb-3">
                            <span><i class="fas fa-clock me-1"></i>@exam.DurationMinutes min</span>
                            <span><i class="fas fa-question-circle me-1"></i>@exam.Questions.Count Questions</span>
                            <span><i class="fas fa-star me-1"></i>@exam.Questions.Sum(q => q.Marks) Marks</span>
                        </div>

                        <div class="mt-auto">
                            @if (done)
                            {
                                <a asp-controller="Student" asp-action="MyResults"
                                   class="btn btn-outline-success w-100">
                                    <i class="fas fa-trophy me-2"></i>View My Result
                                </a>
                            }
                            else if (exam.Questions.Any())
                            {
                                <a asp-controller="Student" asp-action="StartExam"
                                   asp-route-examId="@exam.Id"
                                   class="btn btn-primary w-100"
                                   onclick="return confirm('You are about to start the exam. Make sure you are in a quiet environment. Once started, do NOT switch tabs or press Escape. Ready?')">
                                    <i class="fas fa-play me-2"></i>Start Exam
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>No questions yet</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No exams available yet.</h5>
                <p class="text-muted small">Check back later — your admin will publish exams soon.</p>
            </div>
        }
    </div>
</div>
